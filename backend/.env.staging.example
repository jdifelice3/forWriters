# Application
NODE_ENV=production
PORT=3001
APP_NAME=forWriters Staging
API_DOMAIN=https://staging-api.forwriters.ink
WEBSITE_DOMAIN=https://staging.forwriters.ink
WEB_HOST=https://staging.forwriters.ink

# Application PostgreSQL database (use a staging-only database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/forwriters_staging

# Staging-only SuperTokens Core
SUPERTOKENS_CONNECTION_URI=https://YOUR-STAGING-SUPERTOKENS-CORE
SUPERTOKENS_API_KEY=REPLACE_WITH_STAGING_SUPERTOKENS_KEY

# Amazon S3 (use a staging-only bucket or a staging-only key prefix)
AWS_REGION=us-east-1
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=forwriters-staging
AWS_ACCESS_KEY_ID=REPLACE_WITH_STAGING_IAM_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_IAM_SECRET

# Required for signup verification and password-reset messages
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY

# Use Stripe test-mode values in staging if billing routes are enabled
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_TEST_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_TEST_WEBHOOK_SECRET
